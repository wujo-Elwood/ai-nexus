# 说明：这里的路径规则一律不写死子项目目录名（不再出现 rag-server/ rag-web/），
# 因为项目目录从 rag-server、rag-web 改名为 ai-nexus-server、ai-nexus-web 之后，
# 旧规则整批失效，导致 node_modules 与 target 一度未被忽略。
# Git 的忽略模式会自动匹配任意层级，所以写 `target/` 即可命中 ai-nexus-server/target/。

# ==================== Java / Spring Boot ====================

# Maven 构建产物
target/
*.class
*.jar
*.war

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar

# 日志文件
*.log
logs/

# ==================== IDE ====================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.settings/
.classpath
.project
.factorypath
bin/

# VS Code
.vscode/

# ==================== Node.js / Vue ====================

# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-*/
.vite/
coverage/
*.tsbuildinfo
.eslintcache

# 环境变量
.env
.env.local
.env.*
!.env.example

# ==================== 系统文件 ====================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~
.directory

# ==================== 项目特定 ====================

# 文档
RAG知识库完整流程.md

# 上传的文件目录
uploads/
pic/

# Codex 本地临时文件
.codex-temp/

# 数据库文件（如果有本地 SQLite）
*.db
*.sqlite

# Spring Boot 外部配置
application-local.yml
application-dev.yml

# Qdrant 数据目录（本地开发时）
qdrant_storage/

# Ollama 模型目录
.ollama/

# ==================== 开发探针临时产物 ====================

# tools/dev-probes/*.mjs 每次运行都会在前端目录下建一个
# .chrome-<probe>-<timestamp>/ 无头 Chrome profile 目录。
# 这些目录里的 *.log / *.db 命中上面的忽略规则，所以
# `git clean -fd` 删不掉它们，必须用 `git clean -fdx`。
.chrome-*/
.chrome-*

# ==================== 本地工具与临时产物 ====================

# 本地 AI 助手工作目录
.agents/
.workbuddy/
.workbuddy-ai/
.zcode/
.e2e-content.txt

# 本地调试与视觉验证临时目录
tmp/
visuals/

# 根目录遗留的临时脚本与运行日志
tmp_*.py
rag-server-run.log

# 前端临时构建产物与开发探针
vite.config.js.timestamp-*.mjs
ink_*.png
probe*.mjs
vl_verify.mjs
ai-nexus-web/tools/
